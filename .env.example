# Domain cho Caddy xin chứng chỉ Let's Encrypt. Bắt buộc — compose dừng nếu thiếu.
# Máy dev dùng `localhost` kèm docker-compose.dev.yml (HTTP, không xin cert).
DOMAIN=lms.example.com

# Copy thành .env và điền giá trị thật. KHÔNG commit file .env vào Git.
# Trên VPS: chmod 600 .env

# --- PostgreSQL ---
POSTGRES_DB=langcenter
POSTGRES_USER=langcenter_app
POSTGRES_PASSWORD=doi-gia-tri-nay

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=doi-gia-tri-nay
MINIO_ROOT_PASSWORD=doi-gia-tri-nay
# Bucket chứa ảnh và tệp (ảnh đại diện, logo/ảnh bìa/QR trung tâm, tệp đính kèm học liệu)
# — tạo tự động lần tải đầu
MINIO_BUCKET=langcenter-anh

# --- JWT ---
JWT_SECRET=doi-gia-tri-nay-toi-thieu-32-ky-tu
JWT_ISSUER=langcenter-api
JWT_EXPIRY_MINUTES=60

# --- SMTP (quên mật khẩu; nhắc nợ học phí — chưa nối, nợ N10) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=doi-gia-tri-nay

# --- SMS Gateway ---
SMS_PROVIDER=esms
SMS_API_KEY=doi-gia-tri-nay
SMS_SECRET_KEY=doi-gia-tri-nay

# --- Sentry (error tracking, tuỳ chọn) ---
SENTRY_DSN=

# --- SMTP: địa chỉ người nhận thấy ở ô "From" ---
SMTP_FROM=no-reply@langcenter.local

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Production

# Chuỗi kết nối do docker-compose.yml tự dựng từ POSTGRES_* ở trên — không khai ở đây,
# để không có hai nguồn sự thật cho cùng một giá trị.

# --- Trung tâm đầu tiên (CHỈ dùng khi cài đặt MỚI, DB còn rỗng) ---
#
# VPS mới dựng thì DB rỗng, mà tự đăng ký trung tâm đã đóng mặc định ⇒ không có đường nào
# vào hệ thống. Đặt biến dưới đây thì hệ thống tự tạo trung tâm đầu tiên lúc khởi động.
#
# Hệ thống CỐ Ý không tự sinh mật khẩu: seed chạy trong container, không có đường trả về nào
# ngoài ghi log — mà ai đọc được log server cũng thấy. Bỏ trống ⇒ KHÔNG tạo gì, log nói rõ lý do.
#
# Tối thiểu 12 ký tự (ChinhSachMatKhau.DoDaiToiThieu).
# GỠ biến này khỏi .env sau khi đã đăng nhập và đổi mật khẩu — giữ lại là để mật khẩu nằm
# trong tệp cấu hình mà không còn tác dụng gì.
TRUNG_TAM_DAU_TIEN_MAT_KHAU=
TRUNG_TAM_DAU_TIEN_TEN=Trung tâm của tôi
